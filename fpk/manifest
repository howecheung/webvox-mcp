appname               = webvox-mcp
version               = 1.7.4
display_name          = 联网查询MCP
desc                  = 为 StackChan / 小智等语音机器人提供实时联网搜索能力的 MCP 服务。支持智谱 GLM、阿里百炼 WebSearch MCP 与 DeepSeek 联网搜索，并带结果缓存、用量统计与 Key 加密存储；安装后点击应用图标打开网页配置页完成设置。
platform              = all
source                = thirdparty
maintainer            = howecheung
maintainer_url        = https://github.com/howecheung/webvox-mcp
distributor           = howecheung
distributor_url       = https://github.com/howecheung/webvox-mcp
changelog             = 对外工具名改为纯英文 webvox-search（消除 MCP 命名告警，标题仍是“联网搜索”）；对外工具精简为一个，fetch_url 默认下线，需要时可恢复；修复安装后容器起不来（start.sh 被 Windows 的 CRLF 行尾污染，dash 报 set: Illegal option -）；start.sh 改用 /bin/sh；打包脚本增加行尾归一化自检；桥接自愈：连续重连到达上限后熔断停止重试（不再让容器无限重启），配置页标红并提供“重新连接”按钮；新增自动重连次数上限配置；日志目录与监听地址改由容器环境变量指定；新增 DeepSeek 搜索与网页抓取；新增返回粒度/字符预算/搜索超时；新增结果缓存与用量统计；配置页支持测试搜索；API Key 支持 DPAPI 加密
os_min_version        = 1.1.3100
ctl_stop              = true
service_port          = 8765
checkport             = true
disable_authorization_path = true
desktop_uidir         = ui
desktop_applaunchname = webvox-mcp.main
